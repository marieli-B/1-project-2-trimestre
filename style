 body{
    margin:0;
    font-family:Arial, Helvetica, sans-serif;
    background:#f4f4f4;
}

header{
    background:#7AFFFD;
    color:#000;
    text-align:center;
    max-width:700px;
    margin:20px auto;
    padding:20px;
    border:5px solid blueviolet;
    border-radius:10px;
}

main{
    max-width:700px;
    margin:0 auto 30px auto;
}

article{
     display:flex;
    gap:20px;
    background:white;
    padding:20px;
    margin-bottom:20px;
    border-radius:10px;
    box-shadow:0 2px 8px rgba(0,0,0,0.15);
    align-items:flex-start;
} 
img{
    width:180px;
    border-radius:10px;
    object-fit:cover;
}

.conteudo{
    flex:1;
}

h2{
    margin-top:0;
}

.botoes{
    margin-top:15px;
}

button{
    padding:8px 15px;
    margin-right:10px;
    font-size:18px;
    cursor:pointer;
    border:none;
    border-radius:8px;
    background:#ececec;
    transition:.3s;
}

button:hover{
    background:#d9d9d9;
}

@media(max-width:600px){

article{
    flex-direction:column;
    text-align:center;
}

img{
    width:100%;
}

}
